# Connection string จาก Supabase (Connect → Session pooler, พอร์ต 5432)
# ต้องเป็น session mode — TypeORM synchronize ใช้กับ transaction pooler (6543) ไม่ได้
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ตั้งเป็นข้อความสุ่มยาวๆ สองชุด (ห้ามซ้ำกัน)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ผู้ใช้เก็บในตาราง users ทั้งหมด (ไม่ตั้งใน env)
# สตาร์ทครั้งแรกระบบ seed admin/admin1234 ให้ — เข้าระบบแล้วเปลี่ยนรหัสที่หน้าตั้งค่า

# (ตอน deploy) โดเมนของหน้าเว็บ คั่นด้วย comma
# CORS_ORIGIN=https://your-app.vercel.app

PORT=3001

# Supabase Storage สำหรับไฟล์แนบ (attachments)
# ไม่ตั้งก็ได้ — ระบบจะปิดฟีเจอร์อัปโหลดไฟล์จนกว่าจะใส่ค่าครบ
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_BUCKET=attachments
