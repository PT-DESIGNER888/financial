# Connection string จาก Supabase (Settings → Database → Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ตั้งเป็นข้อความสุ่มยาวๆ สองชุด (ห้ามซ้ำกัน)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ผู้ใช้สำหรับ login (ระบบสร้าง/อัปเดตให้อัตโนมัติตอนสตาร์ท)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# (ตอน deploy) โดเมนของหน้าเว็บ คั่นด้วย comma
# CORS_ORIGIN=https://your-app.vercel.app

PORT=3001
